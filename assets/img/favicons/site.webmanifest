---
layout: compress
---

{% assign favicon_path = "/assets/img/favicons" | relative_url %}

{
  "name": "{{ site.title }}",
  "short_name": "XXL",
  "description": "{{ site.description }}",
  "icons": [
    {
      "src": "{{ favicon_path }}/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "{{ favicon_path }}/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
